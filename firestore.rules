rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzioni Globali
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) && data.uid is string &&
             data.email is string;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['customerId', 'services', 'startTime', 'endTime', 'status', 'totalAmount', 'createdAt']) &&
             data.customerId is string && data.status in ['booked', 'cancelled', 'completed'];
    }

    function isValidNotification(data) {
      return data.userId is string && data.type in ['cancellation', 'booking', 'reschedule_proposal', 'manual_management_required', 'proposal_declined'];
    }

    // ==========================================
    // SPAZIO GLOBALE (Identità e Log)
    // ==========================================
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false; // Solo via Firebase Admin Console
    }

    match /system_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false; // Solo via Firebase Admin Console per sicurezza
    }

    // ==========================================
    // CONFIG GLOBALE (Kill switch versioni)
    // ==========================================
    match /config/{docId} {
      allow read: if true; // Il client deve poterla leggere ad app aperta, anche prima del login
      allow write: if false; // Scrivibile SOLO da Firebase Console (nessuno può manomettere il kill switch)
    }

    // ==========================================
    // SPAZIO MULTI-TENANT (Dati isolati per Salone)
    // ==========================================
    
    match /salons/{tenantId} {
      
      // 🚀 NUOVO RBAC: Controlla se l'utente è nello staff del salone corrente
      function isSalonStaff() {
        return isAuthenticated() && exists(/databases/$(database)/documents/salons/$(tenantId)/staff/$(request.auth.uid));
      }

      match /settings/{settingId} {
        allow read: if true; // I clienti devono leggere gli orari per prenotare
        allow write: if isSalonStaff();
      }

      match /contacts/{contactId} {
        allow read, write, delete: if isSalonStaff();
      }

      match /appointments/{appointmentId} {
        allow read: if isAuthenticated(); 
        allow create: if isAuthenticated() && isValidAppointment(request.resource.data);
       allow update: if isAuthenticated() && (
        isSalonStaff() ||
        (resource.data.customerId == request.auth.uid && 
          request.resource.data.customerId == request.auth.uid &&
          // Autorizza modifiche SOLO a stato e orari. Soldi e servizi restano intoccabili.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startTime', 'endTime', 'updatedAt'])
           ) ||
        //Gestione caso di autolinker 
        (resource.data.customerId == request.auth.uid && resource.data.status == 'booked' && isValidAppointment(request.resource.data)) ||
        (resource.data.customerId != request.auth.uid &&
          request.resource.data.customerId == request.auth.uid &&
          (
            (resource.data.customer.email != null && resource.data.customer.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email) ||
            (resource.data.customer.phoneNumber != null && resource.data.customer.phoneNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId', 'customer', 'isManual'])
        )
      );
        allow delete: if isSalonStaff() || (isAuthenticated() && resource.data.status == 'cancelled') || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSalonStaff());
        allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      }

      match /rescheduleProposals/{proposalId} {
        allow read, write: if isAuthenticated();
      }

      match /calendar_exceptions/{exceptionDate} {
        allow read: if true;
        allow write: if isSalonStaff();
      }
      
      // La lista dei barbieri autorizzati per questo salone
      match /staff/{staffId} {
        allow read: if isAuthenticated();
        allow write: if false; // Gestibile solo da te (Admin Globale) via console o script Node.js
      }
    }

    match /test/connection {
      allow read: if true;
    }
  }
}