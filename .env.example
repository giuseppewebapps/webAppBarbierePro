# ==========================================
# FIREBASE (client) — valori pubblici, finiscono nel bundle
# ==========================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="<progetto>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<progetto>"
VITE_FIREBASE_STORAGE_BUCKET="<bucket>"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# "(default)" per il database Firestore di default; altrimenti l'id del database "nominato".
# Le virgolette eventualmente incollate vengono normalizzate dal codice.
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ==========================================
# API Vercel (solo lato server, MAI nel bundle)
# ==========================================
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Notifiche Salone <info@dominio.it>"
# SYSTEM_EMAIL="info@dominio.it"
# VITE_FIREBASE_PROJECT_ID / VITE_FIREBASE_API_KEY servono anche a api/manifest.ts a runtime

# ==========================================
# Script admin in migrations/ (vedi migrations/_admin.cjs)
# ==========================================
# SERVICE_ACCOUNT_PATH="C:\percorso\service-account.json"
# FIREBASE_PROJECT_ID="<progetto>"
# FIREBASE_DATABASE_ID="(default)"
# FORCE_WRITES="true"   # obbligatorio per gli script che scrivono

# GEMINI_API_KEY: non più usata dall'app.
# La chiave che era committata qui è stata rimossa: va revocata dalla console Google.

